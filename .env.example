# Library Manager Environment Variables
# Copy to .env and fill in your values (never commit .env to git!)

# Library root directory
LIBRARY_ROOT=/mnt/Storage/library

# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Channel ID (negative number, get from @userinfobot)
TELEGRAM_CHANNEL_ID=-1001234567890

# Optional: Bot token (alternative to user session)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: Custom config path
# LIBRARY_MANAGER_CONFIG=/path/to/config.yaml

# Optional: Dry run mode for testing
# DRY_RUN=true