#!/usr/bin/env bash
# lib-clean - Clean up library (empty dirs, temp files, orphaned metadata)

set -euo pipefail

LIBRARY_ROOT="${LIBRARY_ROOT:-/mnt/Storage/library}"
DRY_RUN="${DRY_RUN:-false}"

info() { echo -e "\033[0;34mℹ\033[0m $*"; }
success() { echo -e "\033[0;32m✓\033[0m $*"; }
warn() { echo -e "\033[1;33m⚠\033[0m $*"; }
error() { echo -e "\033[0;31m✗\033[0m $*" >&2; }

if [[ "$DRY_RUN" == "true" ]]; then
    warn "DRY RUN MODE - No changes will be made"
fi

cleanup_count=0

# 1. Remove empty directories in books/
info "Cleaning empty directories in books/..."
while IFS= read -r -d '' dir; do
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "  Would remove: $dir"
    else
        rmdir "$dir" 2>/dev/null && echo "  Removed: $dir" && ((cleanup_count++))
    fi
done < <(find "$LIBRARY_ROOT/books" -type d -empty -print0 2>/dev/null)

# 2. Remove .crdownload files
info "Removing incomplete downloads (.crdownload)..."
while IFS= read -r -d '' file; do
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "  Would remove: $file"
    else
        rm -f "$file" && echo "  Removed: $file" && ((cleanup_count++))
    fi
done < <(find "$LIBRARY_ROOT" -name "*.crdownload" -print0 2>/dev/null)

# 3. Remove .part files
info "Removing partial downloads (.part)..."
while IFS= read -r -d '' file; do
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "  Would remove: $file"
    else
        rm -f "$file" && echo "  Removed: $file" && ((cleanup_count++))
    fi
done < <(find "$LIBRARY_ROOT" -name "*.part" -print0 2>/dev/null)

# 4. Remove orphaned metadata files (metadata for books not in catalog)
info "Checking for orphaned metadata files..."
if [[ -d "$LIBRARY_ROOT/_metadata" ]]; then
    python3 << 'PYEOF'
import json
from pathlib import Path
from library_manager.core.database import get_db

db = get_db()
metadata_dir = Path("/mnt/Storage/library/_metadata")
valid_ids = set()

# Get all valid book IDs from catalog
books = db.get_all_books(status="active", limit=10000)
books += db.get_all_books(status="duplicate", limit=10000)
books += db.get_all_books(status="archived", limit=10000)

for book in books:
    valid_ids.add(str(book.id))

orphans = []
for meta_file in metadata_dir.glob("*.json"):
    book_id = meta_file.stem
    if book_id not in valid_ids:
        orphans.append(meta_file)

if orphans:
    print(f"  Found {len(orphans)} orphaned metadata files")
    for f in orphans[:10]:
        print(f"    {f.name}")
    if len(orphans) > 10:
        print(f"    ... and {len(orphans) - 10} more")
    
    import os
    if os.environ.get("DRY_RUN") != "true":
        for f in orphans:
            f.unlink()
            print(f"  Removed: {f.name}")
else:
    print("  No orphaned metadata files found")
PYEOF
fi

# 5. Clean up Python cache
info "Cleaning Python cache..."
find "$LIBRARY_ROOT/.library-manager" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
find "$LIBRARY_ROOT/.library-manager" -name "*.pyc" -delete 2>/dev/null || true
success "Python cache cleaned"

success "Cleanup complete! Items processed: $cleanup_count"