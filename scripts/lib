#!/usr/bin/env bash
# lib - Unified Library Manager CLI Wrapper
# Provides simplified commands for managing the personal library

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

LIBRARY_ROOT="${LIBRARY_ROOT:-/mnt/Storage/library}"
CONFIG_DIR="${HOME}/.config/library-manager"

# Ensure library-manager is in PATH
export PATH="/usr/local/bin:/usr/bin:${PATH}"

# Helper functions
info() { echo -e "${BLUE}ℹ${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }
error() { echo -e "${RED}✗${NC} $*" >&2; }
header() { echo -e "\n${BOLD}${CYAN}$*${NC}\n"; }

usage() {
    cat << 'USAGE'
lib - Personal Library Manager (simplified wrapper)

USAGE:
    lib <command> [options]

COMMANDS:
    # Setup & Config
    init              Initialize library manager (interactive setup)
    config            Show current configuration
    doctor            Check system health and dependencies

    # Library Operations
    add <file|dir>    Add files to inbox for processing
    organize          Organize & rename all library files
    inbox             Process inbox only (quick)
    rename            Rename files to clean format
    dedupe            Find and isolate duplicates

    # Metadata & Search
    meta              Extract/update metadata for all books
    search "query"    Search library by title/author/description
    info <id|path>    Show detailed book information
    stats             Show library statistics

    # Telegram Cloud Backup
    sync              Push new/changed files to Telegram
    pull              Download missing files from Telegram
    status            Show sync status
    tglist            List files in Telegram channel

    # Maintenance
    verify            Verify all files match catalog
    clean             Remove empty directories & temp files
    watch             Watch inbox for new files (daemon)
    watch-once        Process inbox once (for cron)

    # Automation
    cron-install      Install recommended cron jobs
    cron-remove       Remove library-manager cron jobs
    cron-list         Show current cron jobs

    # Utilities
    help              Show this help
    version           Show version info

EXAMPLES:
    lib add ~/Downloads/book.pdf           # Add single file to inbox
    lib add ~/Downloads/books/             # Add entire directory to inbox
    lib organize                           # Full organize + rename
    lib search "machine learning"          # Search books
    lib info 42                            # Show book details by ID
    lib sync                               # Backup to Telegram
    lib status                             # Check sync status
    lib watch-once                         # Process inbox (cron-friendly)

CONFIGURATION:
    Config file: ~/.config/library-manager/config.yaml
    Library root: /mnt/Storage/library
    Inbox: /mnt/Storage/library/_inbox/

USAGE
}

cmd_init() {
    header "Initializing Library Manager"
    library-manager init
}

cmd_config() {
    header "Current Configuration"
    library-manager config
}

cmd_doctor() {
    header "System Health Check"
    
    # Check Python
    if command -v python3 &>/dev/null; then
        success "Python: $(python3 --version)"
    else
        error "Python 3 not found"
    fi
    
    # Check library-manager
    if command -v library-manager &>/dev/null; then
        success "library-manager: $(library-manager --version 2>/dev/null || echo 'installed')"
    else
        error "library-manager not in PATH"
        info "Run: pip install -e /mnt/Storage/library/.library-manager"
    fi
    
    # Check dependencies
    local deps=("telethon" "pyrogram" "pymupdf" "ebooklib" "magic" "PIL" "yaml" "tqdm" "rich" "click" "watchdog" "xxhash")
    for dep in "${deps[@]}"; do
        if python3 -c "import ${dep}" 2>/dev/null; then
            success "  ${dep}"
        else
            warn "  ${dep} - missing"
        fi
    done
    
    # Check library structure
    if [[ -d "$LIBRARY_ROOT/books" ]]; then
        success "Library root: $LIBRARY_ROOT"
        local book_count=$(find "$LIBRARY_ROOT/books" -type f \( -name "*.pdf" -o -name "*.epub" \) 2>/dev/null | wc -l)
        success "  Books found: $book_count"
    else
        warn "Library root not found: $LIBRARY_ROOT"
    fi
    
    # Check config
    if [[ -f "$CONFIG_DIR/config.yaml" ]]; then
        success "Config file exists: $CONFIG_DIR/config.yaml"
        if grep -q "api_id:" "$CONFIG_DIR/config.yaml" && grep -q "api_hash:" "$CONFIG_DIR/config.yaml"; then
            success "  Telegram credentials configured"
        else
            warn "  Telegram credentials NOT configured"
        fi
    else
        warn "Config file not found: $CONFIG_DIR/config.yaml"
    fi
    
    # Check database
    if [[ -f "$LIBRARY_ROOT/.library-manager/catalog.db" ]]; then
        success "Catalog database exists"
    else
        warn "Catalog database not found"
    fi
}

cmd_add() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        error "Usage: lib add <file|directory>"
        return 1
    fi
    
    if [[ ! -e "$target" ]]; then
        error "Path not found: $target"
        return 1
    fi
    
    header "Adding to Inbox"
    local inbox="$LIBRARY_ROOT/_inbox"
    mkdir -p "$inbox"
    
    if [[ -f "$target" ]]; then
        cp -v "$target" "$inbox/"
        success "Added: $(basename "$target")"
    elif [[ -d "$target" ]]; then
        find "$target" -type f \( -name "*.pdf" -o -name "*.epub" -o -name "*.mobi" -o -name "*.azw3" \) -exec cp -v {} "$inbox/" \;
        success "Added directory contents to inbox"
    fi
    
    info "Run 'lib inbox' or 'lib organize' to process"
}

cmd_organize() {
    header "Organizing Library (full)"
    library-manager --dry-run="${DRY_RUN:-false}" organize
}

cmd_inbox() {
    header "Processing Inbox Only"
    library-manager --dry-run="${DRY_RUN:-false}" organize --inbox-only
}

cmd_rename() {
    header "Renaming Files"
    library-manager --dry-run="${DRY_RUN:-false}" organize --no-rename
    # Actually rename is part of organize, so just run organize
    warn "Rename is integrated into 'organize'. Run 'lib organize' instead."
}

cmd_dedupe() {
    header "Finding Duplicates"
    library-manager --dry-run="${DRY_RUN:-false}" dedupe
}

cmd_meta() {
    header "Extracting Metadata"
    library-manager metadata
}

cmd_search() {
    local query="${1:-}"
    if [[ -z "$query" ]]; then
        error "Usage: lib search \"query\""
        return 1
    fi
    library-manager search "$query"
}

cmd_info() {
    local identifier="${1:-}"
    if [[ -z "$identifier" ]]; then
        error "Usage: lib info <id|path|hash>"
        return 1
    fi
    library-manager info "$identifier"
}

cmd_stats() {
    header "Library Statistics"
    library-manager stats
}

cmd_sync() {
    header "Syncing to Telegram"
    library-manager sync push
}

cmd_pull() {
    header "Downloading from Telegram"
    library-manager sync pull
}

cmd_status() {
    header "Sync Status"
    library-manager sync status
}

cmd_tglist() {
    header "Telegram Channel Files"
    library-manager sync status
    # Additional list via sync manager would need a new command
    python3 -c "
from library_manager.telegram.sync import SyncManager
mgr = SyncManager()
try:
    mgr.connect()
    files = mgr.list_channel_files(50)
    print(f'Found {len(files)} files in channel:')
    for f in files:
        print(f'  #{f[\"message_id\"]} - {f[\"file_name\"]} ({f[\"file_size\"]/1024/1024:.1f} MB)')
except Exception as e:
    print(f'Error: {e}')
"
}

cmd_verify() {
    header "Verifying Library"
    library-manager verify
}

cmd_clean() {
    header "Cleaning Up"
    library-manager clean
}

cmd_watch() {
    header "Watching Inbox (daemon mode - Ctrl+C to stop)"
    library-manager watch
}

cmd_watch_once() {
    header "Processing Inbox Once"
    library-manager watch --once
}

cmd_cron_install() {
    header "Installing Cron Jobs"
    crontab /mnt/Storage/library/.library-manager/crontab.txt
    success "Cron jobs installed"
    crontab -l | grep -E "library-manager|auto_sync"
}

cmd_cron_remove() {
    header "Removing Library Manager Cron Jobs"
    crontab -l | grep -v "library-manager" | grep -v "auto_sync" | crontab -
    success "Library manager cron jobs removed"
}

cmd_cron_list() {
    header "Current Cron Jobs"
    crontab -l | grep -E "library-manager|auto_sync" || info "No library-manager cron jobs found"
}

cmd_version() {
    library-manager --version 2>/dev/null || echo "library-manager 1.0.0"
}

# Main command dispatch
main() {
    local cmd="${1:-help}"
    shift || true
    
    case "$cmd" in
        init)           cmd_init "$@" ;;
        config)         cmd_config "$@" ;;
        doctor)         cmd_doctor "$@" ;;
        add)            cmd_add "$@" ;;
        organize)       cmd_organize "$@" ;;
        inbox)          cmd_inbox "$@" ;;
        rename)         cmd_rename "$@" ;;
        dedupe)         cmd_dedupe "$@" ;;
        meta|metadata)  cmd_meta "$@" ;;
        search)         cmd_search "$@" ;;
        info)           cmd_info "$@" ;;
        stats)          cmd_stats "$@" ;;
        sync)           cmd_sync "$@" ;;
        pull)           cmd_pull "$@" ;;
        status)         cmd_status "$@" ;;
        tglist)         cmd_tglist "$@" ;;
        verify)         cmd_verify "$@" ;;
        clean)          cmd_clean "$@" ;;
        watch)          cmd_watch "$@" ;;
        watch-once)     cmd_watch_once "$@" ;;
        cron-install)   cmd_cron_install "$@" ;;
        cron-remove)    cmd_cron_remove "$@" ;;
        cron-list)      cmd_cron_list "$@" ;;
        help|--help|-h) usage ;;
        version|--version|-v) cmd_version ;;
        *)
            error "Unknown command: $cmd"
            usage
            exit 1
            ;;
    esac
}

main "$@"